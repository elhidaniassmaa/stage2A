# ==========================================
# Configuration de l'environnement GEDEC / MTL
# Copier ce fichier sous le nom '.env' et adapter les valeurs
# ==========================================

# --- Configuration Serveur Backend ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# --- Base de données ---
DATABASE_URL=sqlite:///backend/gedec.db

# --- Sécurité & JWT ---
SECRET_KEY=votre_cle_secrete_jwt_super_securisee_a_changer
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Notifications Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@domaine.gov.ma
SMTP_PASSWORD=votre_mot_de_passe_application

# --- Configuration IA / Transformers ---
MODEL_PATH=models/classification
CONFIDENCE_THRESHOLD=0.70

# --- Configuration Frontend React (Vite) ---
VITE_API_URL=http://localhost:8000
